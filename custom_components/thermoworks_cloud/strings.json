      "humidity": {
        "name": "{channel_name} Humidity"
      },
      "signal": {
        "name": "[%key:component::sensor::entity_component::signal_strength::name%]"
      },
      "fan_state": {
        "name": "State"
      },
      "fan_set_temperature": {
        "name": "Set Temperature"
      },
      "high_alarm_threshold": {
